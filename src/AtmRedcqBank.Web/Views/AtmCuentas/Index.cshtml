@model List<AtmRedcqBank.Web.Models.Entities.Cuenta>
@{
    ViewData["Title"] = "Selección de cuenta";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h3>Seleccione una cuenta</h3>
        <p class="text-muted">Elija la cuenta con la que desea operar</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            No tiene cuentas activas. Puede crear una cuenta digital ahora mismo.
        </div>
        <div class="d-grid gap-2 mt-4">
            <a asp-controller="AtmCrearCuenta" asp-action="Index" class="btn btn-success btn-lg">
                + Crear cuenta
            </a>
            <a asp-controller="AtmAuth" asp-action="Logout" class="btn btn-outline-danger">
                Cancelar y salir
            </a>
        </div>
    }
    else
    {
        <div class="d-grid gap-3 mb-4">
            @foreach (var c in Model)
            {
                <form asp-action="Seleccionar" method="post">
                    <input type="hidden" name="cuentaId" value="@c.Id" />
                    <button type="submit" class="btn btn-outline-primary w-100 text-start p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">
                                    @c.TipoCuenta @(c.SubtipoCuenta != AtmRedcqBank.Web.Models.Enums.SubtipoCuenta.NA ? c.SubtipoCuenta.ToString() : "")
                                </div>
                                <div class="text-muted small">@c.NumeroCuenta.Substring(0, 4) **** @c.NumeroCuenta.Substring(10, 4)</div>
                                <div class="text-muted small">@c.Moneda</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold fs-5">
                                    @(c.Moneda == AtmRedcqBank.Web.Models.Enums.Moneda.PEN ? "S/" : "$") @c.Saldo.ToString("N2")
                                </div>
                                <div class="text-muted small">Saldo disponible</div>
                            </div>
                        </div>
                    </button>
                </form>
            }
        </div>

        <div class="d-grid gap-2">
            <a asp-controller="AtmAuth" asp-action="Logout" class="btn btn-outline-danger">
                Cancelar y salir
            </a>
        </div>
    }
</div>