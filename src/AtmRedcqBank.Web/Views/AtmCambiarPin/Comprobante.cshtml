@{
    ViewData["Title"] = "Comprobante de Cambio de PIN";
    var numOp = ViewBag.NumeroOperacion as string;
}

<div class="container mt-4" style="max-width: 520px;">
    <div class="alert alert-success text-center">
        <h5>✅ PIN cambiado correctamente</h5>
    </div>

    <div class="card shadow">
        <div class="card-body p-4">
            <h5 class="fw-bold text-center mb-3">Comprobante de Cambio de PIN</h5>
            <hr>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Operación</span>
                <span class="fw-semibold">@numOp</span>
            </div>
            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                Por seguridad, no se muestra el PIN en este comprobante.
            </div>
        </div>
    </div>

    <form asp-action="Continuar" method="post" class="mt-4 d-grid">
        <button type="submit" class="btn btn-primary btn-lg w-100">Continuar</button>
    </form>
</div>