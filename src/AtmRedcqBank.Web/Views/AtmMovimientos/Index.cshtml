@model List<AtmRedcqBank.Web.Models.Entities.Transaccion>
@{
    ViewData["Title"] = "Movimientos";
    var cuenta = ViewBag.Cuenta as AtmRedcqBank.Web.Models.Entities.Cuenta;
    
    // Asumimos que si llegamos aquí, la cuenta existe (el controlador lo garantiza)
    if (cuenta == null) return;
    
    var simbolo = cuenta.Moneda == AtmRedcqBank.Web.Models.Enums.Moneda.PEN ? "S/" : "$";
}

<div class="container mt-4" style="max-width: 760px;">
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">@cuenta.TipoCuenta @cuenta.SubtipoCuenta</div>
                <div class="text-muted small">@cuenta.NumeroCuenta.Substring(0, 4) **** @cuenta.NumeroCuenta.Substring(10, 4)</div>
            </div>
            <div class="text-end">
                <div class="text-muted small">Saldo actual</div>
                <div class="fw-bold fs-5">@simbolo @cuenta.Saldo.ToString("N2")</div>
            </div>
        </div>
    </div>

    <h5 class="mb-3">Últimos movimientos</h5>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No hay movimientos registrados.</div>
    }
    else
    {
        <div class="list-group shadow-sm mb-4">
            @foreach (var m in Model)
            {
                var esCredito = m.TipoOperacion == AtmRedcqBank.Web.Models.Enums.TipoOperacion.DEPOSITO || 
                                m.TipoOperacion == AtmRedcqBank.Web.Models.Enums.TipoOperacion.TRANSFERENCIA_RECIBIDA ||
                                m.TipoOperacion == AtmRedcqBank.Web.Models.Enums.TipoOperacion.ABONO_INTERES;
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">@m.TipoOperacion.ToString().Replace("_", " ")</div>
                            <div class="text-muted small">@m.Fecha.ToString("dd/MM/yyyy HH:mm") · Op. @m.NumeroOperacion</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold @(esCredito ? "text-success" : "text-danger")">
                                @(esCredito ? "+" : "-") @simbolo @m.Monto.ToString("N2")
                            </div>
                            <div class="text-muted small">Saldo: @simbolo @m.SaldoPosterior.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="d-grid gap-2 mt-4">
        <a asp-controller="AtmMenu" asp-action="Index" class="btn btn-primary btn-lg">Volver al menú</a>
    </div>
</div>