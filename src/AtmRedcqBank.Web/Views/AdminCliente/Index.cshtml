@model List<AtmRedcqBank.Web.Models.Entities.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Clientes</h3>
        <div>
            <a asp-action="Crear" class="btn btn-primary btn-sm">Nuevo cliente</a>
            <a asp-controller="AdminHome" asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Documento</th>
                        <th>Cliente</th>
                        <th>Email</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.TipoDocumento @c.NumeroDocumento</td>
                            <td>@c.Nombres @c.Apellidos</td>
                            <td class="text-muted small">@c.Email</td>
                            <td class="text-end">
                                <a asp-action="Detalle" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">Sin clientes registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>