@{
    ViewData["Title"] = "Cajero no disponible";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow text-center">
                <div class="card-body p-5">
                    <h1 class="display-4">⚠️</h1>
                    <h3 class="mb-3">Cajero no disponible</h3>
                    <p class="text-muted">Este cajero no se encuentra operativo en este momento.</p>
                    <div class="alert alert-warning">
                        Estado actual: <strong>@ViewBag.EstadoAtm</strong>
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg w-100 mt-3">
                        Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>