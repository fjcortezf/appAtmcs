@model AtmRedcqBank.Web.Models.Entities.Cuenta
@{
    ViewData["Title"] = "Menú principal";
    var simbolo = Model.Moneda == AtmRedcqBank.Web.Models.Enums.Moneda.PEN ? "S/" : "$";
}

<div class="container mt-4" style="max-width: 760px;">

    <!-- Resumen de cuenta -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">
                    @Model.TipoCuenta @(Model.SubtipoCuenta != AtmRedcqBank.Web.Models.Enums.SubtipoCuenta.NA ? Model.SubtipoCuenta.ToString() : "")
                </div>
                <div class="text-muted small">@Model.NumeroCuenta.Substring(0, 4) **** @Model.NumeroCuenta.Substring(10, 4)</div>
            </div>
            <div class="text-end">
                <div class="text-muted small">Saldo disponible</div>
                <div class="fw-bold fs-4">@simbolo @Model.Saldo.ToString("N2")</div>
            </div>
        </div>
    </div>

    <h5 class="text-center text-muted mb-3">¿Qué desea hacer?</h5>

    <div class="row g-3">

        <div class="col-6 col-md-4">
            <a asp-controller="AtmSaldo" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">💵</div>
                <div>Consultar saldo</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmMovimientos" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">📄</div>
                <div>Movimientos</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmTarjeta" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">💳</div>
                <div>Mi tarjeta</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmRetiro" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">🏦</div>
                <div>Retirar</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmDeposito" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">📥</div>
                <div>Depositar</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmTransferencia" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">🔁</div>
                <div>Transferir</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmCambiarPin" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">🔑</div>
                <div>Cambiar PIN</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmCuentas" asp-action="Index" class="btn btn-light border w-100 h-100 py-4 text-decoration-none">
                <div class="fs-2 mb-2">🔄</div>
                <div>Cambiar cuenta</div>
            </a>
        </div>

        <div class="col-6 col-md-4">
            <a asp-controller="AtmAuth" asp-action="Logout" class="btn btn-light border w-100 h-100 py-4 text-decoration-none text-danger">
                <div class="fs-2 mb-2">🚪</div>
                <div>Salir</div>
            </a>
        </div>

    </div>
</div>